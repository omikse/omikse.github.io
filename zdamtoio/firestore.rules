rules_version = '2';

// Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
// NOTHING publishes this automatically. If you edit this file and do not paste
// it, the live rules silently disagree with the repo.
//
// Shape of the world:
//   admins/{uid}            existence IS the admin role; console-only
//   catalog/{examId}        which exams students may see; admin writes
//   users/{uid}             profile
//   users/{uid}/attempts/*  one live attempt per exam, plus archived copies

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin is a document, not a custom claim: claims need the Admin SDK and
    // therefore a backend, and this app deliberately has none.
    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'uid', 'displayName', 'email', 'photoURL',
               'createdAt', 'lastLoginAt', 'loginCount', 'attemptCount'
             ])
          && d.uid == request.auth.uid;
    }

    function validAttempt() {
      let d = request.resource.data;
      return d.examId is string
          && d.answers is map
          && d.grades is map
          && d.status in ['in_progress', 'submitted'];
    }

    // A submitted attempt is a record, not a draft. Once frozen it stays frozen
    // for the student; only an admin can still touch it, to enter a grade.
    function stillOpen() {
      return resource.data.status == 'in_progress';
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;        // granted by hand in the console
    }

    match /catalog/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read:           if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validProfile();
      allow delete:         if false;

      match /attempts/{attemptId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && validAttempt();
        // Students edit their own work while it is open; admins may grade at
        // any point, including after submission.
        allow update: if (isOwner(uid) && validAttempt() && stillOpen()) || isAdmin();
        allow delete: if false;
      }
    }

    // Anything not matched above is denied by default.
  }
}
